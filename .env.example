# ========================================
# Trip Planner Backend — Configuration
# ========================================

# OpenRouter API Key (required)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# LLM Model (optional, default: meta-llama/llama-3.3-70b-instruct)
# Use the model ID from https://openrouter.ai/models
#
# Popular choices:
#   meta-llama/llama-3.3-70b-instruct  (default, good balance)
#   anthropic/claude-sonnet-4          (best reasoning)
#   google/gemini-2.5-flash            (fast, cheap)
#   mistralai/mistral-large-2411       (good for German)
#   deepseek/deepseek-chat             (very cheap)
#   qwen/qwen-2.5-72b-instruct         (good multilingual)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# MCP Server API Keys (optional, for full functionality)
# ------------------------------------------------------

# OpenRouteService — routing and geocoding
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-ors-api-key-here

# Tavily — web search (1000 free requests/month)
# https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# SerpAPI — Google Flights search (100 free searches/month)
# https://serpapi.com
# SERPAPI_API_KEY=your-serpapi-api-key-here
