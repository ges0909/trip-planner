# ========================================
# Trip Planner Backend — Configuration
# ========================================

# LLM Provider Configuration
# --------------------------
# Choose your LLM provider: google (default), openai, or anthropic
# Note: 'gemini' is accepted as alias for 'google'
LLM_PROVIDER=google

# Optional: Override the default model for your provider
# Defaults: google:gemini-2.5-flash, openai:gpt-4o-mini, anthropic:claude-haiku-4-5
# Can be specified as "model-name" (provider prefix added) or "provider:model-name"
# LLM_MODEL=gemini-2.5-flash

# API Keys (only the key for your chosen provider is required)
# ------------------------------------------------------------

# Google Gemini API key (required if LLM_PROVIDER=google)
# Get yours free at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key (required if LLM_PROVIDER=openai)
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (required if LLM_PROVIDER=anthropic)
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# MCP Server API Keys
# -------------------
# These are required for the MCP tools to function

# OpenRouteService API key (free tier available)
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-ors-api-key-here

# Tavily Search API key (1000 free requests/month)
# https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# SerpAPI key for Google Flights (100 free searches/month)
# https://serpapi.com
# SERPAPI_API_KEY=your-serpapi-api-key-here
